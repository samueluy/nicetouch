{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NiceTouch rule definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "app",
    "gesture",
    "action"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f]*\\S)?$"
    },
    "app": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(\\*|[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+)$"
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fingers",
        "direction",
        "zone"
      ],
      "properties": {
        "kind": {
          "enum": [
            "swipe",
            "tap",
            "drawC"
          ]
        },
        "fingers": {
          "type": "integer",
          "enum": [
            1,
            3,
            4
          ]
        },
        "direction": {
          "enum": [
            "left",
            "right",
            "up",
            "down",
            "none"
          ]
        },
        "zone": {
          "enum": [
            "anywhere",
            "left",
            "right",
            "top",
            "bottom"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drawC"
              }
            }
          },
          "then": {
            "properties": {
              "fingers": {
                "const": 1
              },
              "direction": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "fingers": {
                "enum": [
                  3,
                  4
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "swipe"
              }
            }
          },
          "then": {
            "properties": {
              "direction": {
                "enum": [
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "direction": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "action": {
      "enum": [
        "previousTab",
        "nextTab",
        "closeTab",
        "reopenTab",
        "copy",
        "paste",
        "undo",
        "redo",
        "openChatGPT",
        "openCodex"
      ]
    }
  }
}
